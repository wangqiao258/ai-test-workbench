[Unit]
Description=AI Test Workbench Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=workbench
Group=workbench
WorkingDirectory=/opt/ai-test-workbench
EnvironmentFile=-/etc/workbench/runner.env
ExecStart=/opt/ai-test-workbench/.venv/bin/python -m workbench_runner
Restart=always
RestartSec=5
Nice=10
CPUQuota=200%
MemoryMax=2G
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
