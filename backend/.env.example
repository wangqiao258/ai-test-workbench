APP_ENV=dev
# 本地开发库；生产部署时替换为实际地址与凭据
DATABASE_URL=postgresql+psycopg://aitest:CHANGE_ME@127.0.0.1:5432/aitest
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STORAGE_DIR=storage
# 结构化访问日志（JSONL，按天切分）；日志目录需可写
ACCESS_LOG_PATH=logs/access.log
ACCESS_LOG_RETENTION_DAYS=90

# Runner（单独进程，按需配置）
WORKBENCH_RUNNER_PLATFORM_URL=http://127.0.0.1:8000
# 项目规格根目录：每个项目的 YAML 在 <SPEC_DIR>/<projectId>/ 下
WORKBENCH_RUNNER_SPEC_DIR=storage/specs
WORKBENCH_RUNNER_WORKDIR=storage/runner
WORKBENCH_RUNNER_POLL_SECONDS=5
WORKBENCH_RUNNER_TIMEOUT=1800
# 心跳与租约：执行器每 N 秒续期，租约过期视为失联并回收任务
WORKBENCH_RUNNER_HEARTBEAT_SECONDS=15
WORKBENCH_RUNNER_LEASE_SECONDS=90
# 被中断的任务最多执行次数（含首次），超过后标记失败
WORKBENCH_RUNNER_MAX_ATTEMPTS=2
# projectId -> 项目级 Token 的 JSON；Token 在项目设置 → AI 接入中生成（需 runs:write）
WORKBENCH_PROJECT_TOKENS={"00000000-0000-0000-0000-000000000000":"CHANGE_ME"}
